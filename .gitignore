# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
/.next/
/out/
/build
next-env.d.ts

# Production
/dist

# Environment — NEVER commit these.
# Corrected 2026-09-14. This said the only variable the app reads is
# CONTACT_WEBHOOK_URL; that variable is now read by no code here at all.
# The app reads four, all in src/lib/enquiries.ts and all by NAME, never by
# value: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY and
# CONTACT_NOTIFICATION_FROM. TWO OF THEM ARE SECRETS — the Supabase service-role
# key bypasses row-level security, and the Resend key can send as the domain —
# where the old webhook URL was one capability-bearing string. That raises what
# an accidental commit of a .env file here would cost, not lowers it.
.env
.env.*
!.env.example

# Testing / coverage
/coverage

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.pem
Thumbs.db

# Vercel / deployment
.vercel

# TypeScript
*.tsbuildinfo

# Local audit scratch
/audit-output

# Python bytecode. scripts/ is run with `py -3.12 -B` so none should be
# produced; this is the belt to that braces. NOTE: scripts/__pycache__/
# audit.cpython-314.pyc was committed before this rule and stays tracked -
# an ignore rule never untracks a file, and removing one is not this
# script-hygiene change to make.
__pycache__/
